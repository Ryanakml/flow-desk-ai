NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
API_PORT=4000
INGRESS_PORT=4001
WORKER_HEALTH_PORT=4002
SCHEDULER_HEALTH_PORT=4003
SERVICE_VERSION=dev
GIT_SHA=local
LOG_LEVEL=info
DATABASE_URL=postgresql://flowdesk:flowdesk_local@127.0.0.1:5433/flowdesk
# Used only by the separately-invoked migration release job. Production uses a
# distinct, least-privilege migrator identity; this local bootstrap account is synthetic.
DATABASE_MIGRATOR_URL=postgresql://flowdesk:flowdesk_local@127.0.0.1:5433/flowdesk
REDIS_URL=redis://localhost:6379
S3_BUCKET=flowdesk-local
S3_REGION=ap-southeast-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=flowdesk
S3_SECRET_ACCESS_KEY=flowdesk_local_only
MAILPIT_SMTP_URL=smtp://localhost:1025
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=flowdesk
FEATURE_FLAGS_PROVIDER=environment
BOT_AUTOSEND_DEFAULT_ENABLED=false
AUTH_OIDC_ISSUER=https://flowdesk.local.auth0.com/
AUTH_OIDC_CLIENT_ID=flowdesk-local-client
AUTH_OIDC_CLIENT_SECRET=flowdesk-local-secret
AUTH_OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/callback
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
AUTH_MOCK_ENABLED=true

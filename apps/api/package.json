{
  "name": "@flowdesk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/channels.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@flowdesk/config": "workspace:*",
    "@flowdesk/contracts": "workspace:*",
    "@flowdesk/db": "workspace:*",
    "@flowdesk/domain": "workspace:*",
    "@flowdesk/observability": "workspace:*",
    "@flowdesk/providers": "workspace:*",
    "@flowdesk/security": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^5.1.0",
    "pg": "8.16.3",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "8.15.5",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5"
  }
}

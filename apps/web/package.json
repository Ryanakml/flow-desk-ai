{
  "name": "@flowdesk/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && cp server.mjs dist/index.js",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@flowdesk/config": "workspace:*",
    "@flowdesk/contracts": "workspace:*",
    "@flowdesk/domain": "workspace:*",
    "@flowdesk/ui": "workspace:*",
    "lucide-react": "^1.41.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sirv": "^3.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.3"
  }
}

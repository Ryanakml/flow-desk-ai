FROM node:22.21.1-bookworm-slim AS builder
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY scripts ./scripts
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile
ARG APP
RUN pnpm turbo run build --filter="@flowdesk/${APP}..."
RUN pnpm --filter="@flowdesk/${APP}" deploy --prod /output

FROM node:22.21.1-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system --gid 10001 flowdesk && useradd --system --uid 10001 --gid flowdesk --home-dir /app flowdesk
COPY --from=builder --chown=flowdesk:flowdesk /output ./
USER flowdesk
EXPOSE 3000 4000 4001 4002 4003
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/livez').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
